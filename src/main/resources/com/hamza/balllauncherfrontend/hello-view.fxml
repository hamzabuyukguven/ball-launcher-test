<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hamza.balllauncherfrontend.HelloController"
            prefWidth="780" prefHeight="920"
            style="-fx-background-color: #23252e;">

    <top>
        <VBox>
            <HBox fx:id="headerBar" alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: #18324a; -fx-padding: 16;">
                <Label text="GUN LAUNCHER CONTROL"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="connectionLabel" text="DISCONNECTED"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 6 16; -fx-background-radius: 4; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="emergencyBanner" text="EMERGENCY STOP ACTIVE — SEND ANY COMMAND TO RELEASE"
                   maxWidth="Infinity" alignment="CENTER" visible="false" managed="false"
                   style="-fx-background-color: #b62b2b; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 16;">

            <HBox spacing="12" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2e313c; -fx-background-radius: 8; -fx-border-color: #3f434f; -fx-border-radius: 8; -fx-padding: 12;">
                    <Label text="AVAILABILITY" style="-fx-text-fill: #9aa3b2; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="availabilityLabel" text="UNKNOWN"
                           style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 4 14; -fx-background-radius: 4; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2e313c; -fx-background-radius: 8; -fx-border-color: #3f434f; -fx-border-radius: 8; -fx-padding: 12;">
                    <Label text="ALIGNMENT" style="-fx-text-fill: #9aa3b2; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="aimLabel" text="ALIGNING"
                           style="-fx-background-color: #d98324; -fx-text-fill: white; -fx-padding: 4 14; -fx-background-radius: 4; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2e313c; -fx-background-radius: 8; -fx-border-color: #3f434f; -fx-border-radius: 8; -fx-padding: 12;">
                    <Label text="FIRE SAFETY" style="-fx-text-fill: #9aa3b2; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="readyLabel" text="NOT READY"
                           style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 4 14; -fx-background-radius: 4; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <HBox spacing="12">

                <VBox spacing="10" prefWidth="335" maxHeight="Infinity" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2e313c; -fx-background-radius: 8; -fx-border-color: #3f434f; -fx-border-radius: 8; -fx-padding: 16;">
                    <Label text="TARGETING PARAMETERS"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e6e9ee;"/>
                    <Separator style="-fx-background-color: #3f434f;"/>
                    <GridPane hgap="10" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="70"/>
                            <ColumnConstraints minWidth="130" maxWidth="130"/>
                        </columnConstraints>
                        <Label text="Target X" style="-fx-text-fill: #c3c9d4;"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="targetXField" promptText="-250.0" prefWidth="130"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Target Y" style="-fx-text-fill: #c3c9d4;"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="targetYField" promptText="220.0" prefWidth="130"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Ball Type" style="-fx-text-fill: #c3c9d4;"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="ballTypeField" promptText="Select" prefWidth="130"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="SET TARGET" onAction="#onSetTargetButtonClick" maxWidth="Infinity"
                            style="-fx-background-color: #2878b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9;"/>
                    <Button text="USE SIMULATION TARGET STREAM" onAction="#onUseTrackedTarget" maxWidth="Infinity"
                            style="-fx-background-color: #3f434f; -fx-text-fill: #e6e9ee; -fx-padding: 9;"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER" prefWidth="335" maxHeight="Infinity" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #2e313c; -fx-background-radius: 8; -fx-border-color: #3f434f; -fx-border-radius: 8; -fx-padding: 16;">
                    <Label text="PLATFORM POSITION"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e6e9ee;"/>
                    <Separator style="-fx-background-color: #3f434f;"/>
                    <Canvas fx:id="compassCanvas" width="230" height="230"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Label fx:id="coordinatesLabel" text="X: 0.00 m Y: 0.00 m"
                               style="-fx-font-size: 13px; -fx-text-fill: #e6e9ee;"/>
                        <HBox spacing="0">
                            <ToggleButton fx:id="unitMeterToggle" text="m" selected="true" prefWidth="42"
                                          style="-fx-background-radius: 4 0 0 4; -fx-font-size: 11px;"/>
                            <ToggleButton fx:id="unitKnotToggle" text="kn" prefWidth="42"
                                          style="-fx-background-radius: 0 4 4 0; -fx-font-size: 11px;"/>
                        </HBox>
                    </HBox>

                    <HBox spacing="18" alignment="CENTER">
                        <Label fx:id="panLabel" text="Pan: 0.00°" style="-fx-text-fill: #c3c9d4;"/>
                        <Label fx:id="tiltLabel" text="Tilt: 0.00°" style="-fx-text-fill: #c3c9d4;"/>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="Ammunition:" style="-fx-text-fill: #9aa3b2;"/>
                        <Label fx:id="ammoLabel" text="0"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #e6e9ee;"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <Button fx:id="stowButton" text="STOW" onAction="#onStowButtonClick"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #4a8cd2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12; -fx-background-radius: 4;"/>
                <Button fx:id="fireButton" text="FIRE" onAction="#onFireButtonClick" disable="true"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #d96b38; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12; -fx-background-radius: 4;"/>
            </HBox>

            <Button fx:id="emergencyButton" text="EMERGENCY STOP" onAction="#onEmergencyStopButtonClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #b62b2b; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12; -fx-background-radius: 4;"/>

            <Label fx:id="statusMessageLabel" text="Starting..." maxWidth="Infinity" wrapText="true"
                   style="-fx-background-color: #2e313c; -fx-padding: 10; -fx-background-radius: 5; -fx-text-fill: #c3c9d4;"/>

            <HBox spacing="12">
                <Button text="REPORTS" onAction="#onReportsButtonClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #636573; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9;"/>
                <Button text="HELP" onAction="#onHelpButtonClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #3f434f; -fx-text-fill: #e6e9ee; -fx-padding: 9;"/>
            </HBox>

            <TextArea fx:id="reportsArea" editable="false" wrapText="true" visible="false" prefHeight="160"
                      promptText="Simulation and gun fault reports appear here."
                      style="-fx-control-inner-background: #1a1c23; -fx-text-fill: white; -fx-font-family: 'Courier New';"/>
        </VBox>
    </center>
</BorderPane>
