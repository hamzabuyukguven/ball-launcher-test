<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hamza.balllauncherfrontend.HelloController"
            prefHeight="850.0" prefWidth="730.0"
            style="-fx-background-color: #434449;">

    <AnchorPane prefHeight="100.0" style="-fx-background-color: #e5e5e5;"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>

    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
        <Label fx:id="readyLabel" text="NOT READY" alignment="CENTER"
               prefWidth="160.0" prefHeight="40.0"
               style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-font-size: 14px;"/>
    </HBox>

    <Button text="REPORTS" onAction="#onReportsButtonClick"
            prefWidth="160.0" prefHeight="40.0"
            AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="200.0"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-font-size: 14px; -fx-alignment: center;"/>

    <Label fx:id="connectionLabel" text="DISCONNECTED" alignment="CENTER"
           prefWidth="160.0" prefHeight="40.0"
           AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="200.0"
           style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-font-size: 14px;"/>

    <VBox spacing="10.0" prefWidth="240.0"
          AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="280.0"
          style="-fx-background-color: #636573; -fx-padding: 20; -fx-background-radius: 4;">

        <Label text="TARGETING PARAMETERS" maxWidth="Infinity" alignment="CENTER" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>

        <Label text="Target X Coordinate" maxWidth="Infinity" alignment="CENTER" style="-fx-text-fill: #dcdcdc; -fx-font-size: 12px;"/>
        <TextField fx:id="targetXField" alignment="CENTER" promptText="0.00" style="-fx-background-color: #e2e2e2; -fx-font-weight: bold;"/>

        <Label text="Target Y Coordinate" maxWidth="Infinity" alignment="CENTER" style="-fx-text-fill: #dcdcdc; -fx-font-size: 12px;"/>
        <TextField fx:id="targetYField" alignment="CENTER" promptText="0.00" style="-fx-background-color: #e2e2e2; -fx-font-weight: bold;"/>

        <Label text="AMMUNITION" maxWidth="Infinity" alignment="CENTER" style="-fx-text-fill: #dcdcdc; -fx-font-size: 12px;"/>
        <TextField fx:id="ammunitionField" alignment="CENTER" editable="false" style="-fx-background-color: #e2e2e2; -fx-font-weight: bold;"/>

        <Label text="BALL TYPE" maxWidth="Infinity" alignment="CENTER" style="-fx-text-fill: #dcdcdc; -fx-font-size: 12px;"/>
        <TextField fx:id="ballTypeField" alignment="CENTER" style="-fx-background-color: #e2e2e2; -fx-font-weight: bold;"/>
    </VBox>

    <Canvas fx:id="compassCanvas" width="260.0" height="260.0"
            AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="280.0"/>

    <VBox spacing="20.0" prefWidth="180.0"
          AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="600.0">
        <Button text="STOW" onAction="#onStowButtonClick"
                prefWidth="180.0" prefHeight="45.0"
                style="-fx-background-color: #4a8cd2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 4; -fx-alignment: center;"/>

        <Button text="FIRE" onAction="#onFireButtonClick"
                prefWidth="180.0" prefHeight="45.0"
                style="-fx-background-color: #d96b38; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 4; -fx-alignment: center;"/>
    </VBox>

    <Button text="EMERGENCY&#10;STOP" onAction="#onEmergencyStopButtonClick" textAlignment="CENTER"
            prefWidth="200.0" prefHeight="80.0"
            AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="650.0"
            style="-fx-background-color: #d93838; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 4; -fx-alignment: center;"/>

    <TextArea fx:id="reportsArea" editable="false" visible="false"
              prefWidth="640.0" prefHeight="120.0"
              AnchorPane.leftAnchor="50.0" AnchorPane.TopAnchor="725.0"
              style="-fx-control-inner-background: #1e1e26; -fx-text-fill: white;"/>

</AnchorPane>





