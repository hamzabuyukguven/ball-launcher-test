<?xml version="1.0"?>
<sdf version="1.10">
  <world name="heybeliada_gun_test_world">
    <physics name="physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.08 0.08 0.09 1</ambient>
            <diffuse>0.15 0.15 0.17 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://heybeliada_gun_test</uri>
      <pose>0 0 0.3 0 0 0</pose>
    </include>
    <!-- Sadece goruntu veren duz deniz yuzeyi -->
    <model name="visual_ocean">
      <static>true</static>

      <!-- x y z roll pitch yaw -->
      <pose>0 0 -10 0 0 0</pose>

      <link name="ocean_link">
        <visual name="ocean_visual">
          <cast_shadows>false</cast_shadows>

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.01 0.12 0.20 1</ambient>
            <diffuse>0.01 0.30 0.46 1</diffuse>
            <specular>0.30 0.50 0.60 1</specular>

            <pbr>
              <metal>
                <roughness>0.18</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
