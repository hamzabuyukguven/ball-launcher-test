<?xml version="1.0"?>
<sdf version="1.9">
  <world name="launcher_world">
    <gravity>0 0 -9.81</gravity>

    <physics name="one_millisecond" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><box><size>80 80 0.10</size></box></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><box><size>80 80 0.10</size></box></geometry>
          <material><ambient>0.22 0.30 0.22 1</ambient><diffuse>0.28 0.40 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="range_mark_10m">
      <static>true</static>
      <pose>10 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.05 12 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual>
      </link>
    </model>

    <model name="range_mark_20m">
      <static>true</static>
      <pose>20 0 0.055 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.05 12 0.01</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual>
      </link>
    </model>

    <include>
      <uri>model://ball_launcher</uri>
    </include>
  </world>
</sdf>
