<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="projectile_ball" canonical_link="ball_link">
    <link name="ball_link">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.001536</ixx>
          <iyy>0.001536</iyy>
          <izz>0.001536</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="ball_visual">
        <geometry>
          <sphere>
            <radius>0.16</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0.15 0.02 1</ambient>
          <diffuse>1 0.20 0.02 1</diffuse>
          <emissive>0.8 0.08 0.01 1</emissive>
        </material>
      </visual>
      <collision name="ball_collision">
        <geometry>
          <sphere>
            <radius>0.16</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.25</mu>
              <mu2>0.25</mu2>
