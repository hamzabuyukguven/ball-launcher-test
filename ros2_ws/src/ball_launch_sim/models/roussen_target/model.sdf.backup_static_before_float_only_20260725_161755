<?xml version="1.0"?>
<sdf version="1.9">
  <model name="roussen_target">
    <!-- Stationary target. Remove static=true only after adding proper mass and hydrodynamics. -->
    <static>true</static>

    <link name="base_link">
      <!-- Export script places the waterline at mesh Z=0. -->
      <visual name="ship_visual">
        <geometry>
          <mesh>
            <uri>model://roussen_target/meshes/roussen.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Simple collisions are intentionally used instead of the detailed render mesh. -->
      <collision name="main_hull_collision">
        <pose>-1 0 -1.25 0 0 0</pose>
        <geometry>
          <box><size>50 8.6 3.2</size></box>
        </geometry>
      </collision>

      <collision name="bow_collision">
        <pose>25 0 -1.0 0 0 0</pose>
        <geometry>
          <box><size>10 5.6 2.6</size></box>
        </geometry>
      </collision>

      <collision name="superstructure_collision">
        <pose>-3 0 2.4 0 0 0</pose>
        <geometry>
          <box><size>20 7.0 4.8</size></box>
        </geometry>
      </collision>
    </link>
  
    <!--
      Target telemetry compatibility:
      Preserve the old WAM-V pose stream for the entity named wam_v.
    -->
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">

      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>

      <!-- Existing bridge is expected to consume gz.msgs.Pose. -->
      <use_pose_vector_msg>true</use_pose_vector_msg>

      <!-- Keep static target data on /pose instead of /pose_static. -->
      <static_publisher>false</static_publisher>

      <update_frequency>20</update_frequency>
    </plugin>

</model>
</sdf>
