# Ball Launcher integrated system settings
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_ADVERTISED_HOST=127.0.0.1
SIMULATION_GRPC_HOST=127.0.0.1
SIMULATION_GRPC_PORT=50052

# Backend gun control
CONTROL_ENABLED=true
MAX_PAN_RATE=0.20
MAX_TILT_RATE=0.10
MUZZLE_VELOCITY=100.0

# The launcher auto-detects common simulation scripts when this is empty.
# To force a command, set for example:
# SIMULATION_START_COMMAND="$HOME/start_heybeliada_with_fire.sh"
SIMULATION_START_COMMAND=""

# Optional manual/test tools. Leave empty for auto-detection.
PLATFORM_CONTROLLER_COMMAND=""
PHONE_CONTROL_COMMAND="/home/fatih/start_phone_control_ship_only.sh"
