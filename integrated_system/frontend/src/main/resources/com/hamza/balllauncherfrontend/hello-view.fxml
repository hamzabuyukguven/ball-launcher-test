<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hamza.balllauncherfrontend.HelloController"
            style="-fx-background-color: #f4f6f8;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #18324a; -fx-padding: 18;">
            <Label text="BALL LAUNCHER CONTROL" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label text="Simulation / Backend / Kafka" style="-fx-text-fill: #c9d8e5; -fx-font-size: 13px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Connection:" style="-fx-text-fill: white;" />
            <Label fx:id="connectionStatusLabel" text="DISCONNECTED"
                   style="-fx-text-fill: #ffb3b3; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <GridPane hgap="16" vgap="16" style="-fx-padding: 18;">
            <columnConstraints>
                <ColumnConstraints percentWidth="34" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="34" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="32" hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>

            <VBox spacing="12" GridPane.columnIndex="0"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18; -fx-border-color: #d9e0e6; -fx-border-radius: 8;">
                <Label text="System Telemetry" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                <Separator />
                <Label text="Status" style="-fx-text-fill: #607080;" />
                <Label fx:id="availabilityLabel" text="DISCONNECTED" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Label text="Platform Position" style="-fx-text-fill: #607080;" />
                <Label fx:id="coordinatesLabel" text="X: 0.00 m   Y: 0.00 m" />
                <Label fx:id="panLabel" text="Pan: 0.00°" />
                <Label fx:id="tiltLabel" text="Tilt: 0.00°" />
                <Label text="Ammunition" style="-fx-text-fill: #607080;" />
                <Label fx:id="ammoLabel" text="0 × N/A" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Alignment" style="-fx-text-fill: #607080;" />
                        <Label fx:id="aimLabel" text="ALIGNING" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fire Safety" style="-fx-text-fill: #607080;" />
                        <Label fx:id="readyLabel" text="SAFETY LOCKED" style="-fx-font-weight: bold;" />
                    </VBox>
                </HBox>
                <Canvas fx:id="compassCanvas" width="300" height="270" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="12" GridPane.columnIndex="1"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18; -fx-border-color: #d9e0e6; -fx-border-radius: 8;">
                <Label text="Target and Fire Control" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                <Separator />
                <Label text="Target coordinates use simulation world coordinates (meters)." wrapText="true"
                       style="-fx-text-fill: #607080;" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="75" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="Target X" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="targetXField" promptText="e.g. -250.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="Target Y" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="targetYField" promptText="e.g. 220.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="Target Z" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="targetZField" promptText="leave blank for 0.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                </GridPane>
                <Button text="SEND TARGET" onAction="#onSetTarget" maxWidth="Infinity"
                        style="-fx-background-color: #2878b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                <Button text="USE SIMULATION TARGET STREAM" onAction="#onUseTrackedTarget" maxWidth="Infinity" />
                <Label text="A fire request does not fire immediately. The backend fires only after verifying target alignment, simulation readiness, gun status, and ammunition."
                       wrapText="true" style="-fx-text-fill: #607080;" />
                <Button fx:id="fireButton" text="SEND FIRE REQUEST" onAction="#onFire" maxWidth="Infinity" disable="true"
                        style="-fx-background-color: #b62b2b; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14;" />
                <Button text="STOW POSITION" onAction="#onStow" maxWidth="Infinity" />
                <Separator />
                <Button text="EMERGENCY STOP" onAction="#onEmergencyStop" maxWidth="Infinity"
                        style="-fx-background-color: #7e1111; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                <Button text="EMERGENCY STOPMAYI KALDIR" onAction="#onClearEmergencyStop" maxWidth="Infinity" />
                <Label fx:id="statusMessageLabel" text="Starting..." wrapText="true"
                       style="-fx-background-color: #eef2f5; -fx-padding: 10; -fx-background-radius: 5;" />
            </VBox>

            <VBox spacing="12" GridPane.columnIndex="2"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18; -fx-border-color: #d9e0e6; -fx-border-radius: 8;">
                <Label text="System Reports" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                <Separator />
                <TextArea fx:id="reportArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          promptText="Simulation and gun fault reports appear here." />
            </VBox>
        </GridPane>
    </center>

    <bottom>
        <Label text="Phone control remains available as a separate manual/test tool for ship and target movement. Do not let two sources publish gun-rate or fire commands at the same time."
               wrapText="true" style="-fx-background-color: #e7edf2; -fx-padding: 10 18 10 18; -fx-text-fill: #405160;"
               BorderPane.alignment="CENTER_LEFT" />
    </bottom>
</BorderPane>
